# Sample symlinks — machine-specific, regenerate with: python3 scripts/setup_samples.py
samples/**/*.wav

# Log sessions
log_sessions/

# PID file
.pids

# Node deps (collab server) — restore with: cd server && npm install
node_modules/

# Agent worktrees / local Claude state
.claude/

# Python bytecode — generated beside serve.py / serve-lan.py / relay.py
__pycache__/
*.pyc

# Editor / OS cruft
.DS_Store

# Editor swap/backup files
*.kate-swp
*.swp
*~

# Self-signed cert for serve-lan.py
.cert/
