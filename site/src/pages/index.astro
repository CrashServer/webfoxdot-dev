---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Play from '../components/Play.astro';
import Pipeline from '../components/Pipeline.astro';
import Features from '../components/Features.astro';
import Install from '../components/Install.astro';
import Examples from '../components/Examples.astro';
import SynthGrid from '../components/SynthGrid.astro';
import QuickStart from '../components/QuickStart.astro';
import Credits from '../components/Credits.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />
  <main>
    <Hero />
    <div class="wrap"><div class="divider"></div></div>
    <Play />
    <div class="wrap"><div class="divider"></div></div>
    <Pipeline />
    <div class="wrap"><div class="divider"></div></div>
    <Features />
    <div class="wrap"><div class="divider"></div></div>
    <Install />
    <Examples />
    <div class="wrap"><div class="divider"></div></div>
    <SynthGrid />
    <div class="wrap"><div class="divider"></div></div>
    <QuickStart />
    <div class="wrap"><div class="divider"></div></div>
    <Credits />
  </main>
  <Footer />
</Base>
