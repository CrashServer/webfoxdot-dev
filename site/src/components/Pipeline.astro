---
const steps = [
  { k: 'Editor', d: 'FoxDot-style Python in a CodeMirror editor' },
  { k: 'Transpiler', d: 'Python → JavaScript in real time (>> operator, kwargs)' },
  { k: 'Player engine', d: 'A JS clock schedules notes & pattern steps' },
  { k: 'scsynth (WASM)', d: 'SuperCollider server compiled to WebAssembly' },
  { k: 'Web Audio', d: 'AudioWorklet streams sample-accurate audio out' },
];
---
<section id="how">
  <div class="wrap">
    <span class="eyebrow">trace --signal-path</span>
    <h2 class="section-title">Yes, that's actual SuperCollider in your tab</h2>
    <p class="section-lead">
      No server round-trips, no native install, no "did it boot?" anxiety. The
      whole signal path — from the text you type to the sound that escapes — runs
      locally, in the browser, where audio engines fear to tread.
    </p>

    <ol class="pipe">
      {steps.map((s, idx) => (
        <li class="pipe-step bracket">
          <span class="pipe-i">{String(idx + 1).padStart(2, '0')}</span>
          <span class="pipe-k">{s.k}</span>
          <span class="pipe-d">{s.d}</span>
          {idx < steps.length - 1 && <span class="pipe-arrow" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>

    <p class="pipe-note">
      SynthDefs are precompiled to <code class="inline">.scsyndef</code> binaries
      and loaded at boot. SuperCollider itself is only needed if you write new
      synths — everyone else just opens the page and pretends WebAssembly isn't
      quietly terrifying.
    </p>
  </div>
</section>

<style>
  .pipe {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  .pipe-step {
    position: relative;
    background: var(--bg-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius);
    padding: 20px 16px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .pipe-step:hover { border-color: var(--green); transform: translateY(-3px); }
  .pipe-i {
    display: block;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--green);
    letter-spacing: 0.1em;
    margin-bottom: 12px;
    text-shadow: 0 0 10px var(--glow);
  }
  .pipe-i::before { content: "["; color: var(--text-3); margin-right: 2px; }
  .pipe-i::after { content: "]"; color: var(--text-3); margin-left: 2px; }
  .pipe-k {
    display: block;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 14px;
    color: var(--text-1);
    margin-bottom: 6px;
  }
  .pipe-d { display: block; font-size: 13px; color: var(--text-2); }
  .pipe-arrow {
    position: absolute;
    right: -10px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--border-2);
    font-size: 16px;
    z-index: 1;
  }
  .pipe-note {
    margin: 28px 0 0;
    color: var(--text-2);
    font-size: 15px;
    max-width: 70ch;
  }
  @media (max-width: 880px) {
    .pipe { grid-template-columns: repeat(2, 1fr); }
    .pipe-arrow { display: none; }
  }
  @media (max-width: 480px) {
    .pipe { grid-template-columns: 1fr; }
  }
</style>
