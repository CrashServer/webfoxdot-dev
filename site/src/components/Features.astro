---
const features = [
  {
    t: 'Zero install · works offline',
    d: "scsynth runs as WebAssembly right in the tab — no SuperCollider, no Python, no 47-step build guide that breaks on step 46. Install it as an app and it boots &amp; plays with the Wi‑Fi off.",
  },
  {
    t: 'FoxDot syntax',
    d: "The player >> synth() idiom you already muscle-memorized, transpiled to JS live. Your old FoxDot sets mostly just work. Mostly.",
  },
  {
    t: '46+ synths',
    d: "dbass, hoover, acidbass, cs80, a whole French-electro pack, the ikea glitch machine — ported from FoxDot &amp; CrashServer's SuperCollider stash. The hoover is non-negotiable.",
  },
  {
    t: '50+ ways to ruin a sound',
    d: "Reverb, drive, bitcrush, fold, vowel, shimmer, clouds, octclean, squiz… routed lazily so clean players stay clean. Stack them until the neighbours file a complaint.",
  },
  {
    t: 'Jam together, live',
    d: "One click turns your set into a shared room — everyone edits the same code in real time, clocks in sync. Send a link, jam with a stranger across the planet.",
  },
  {
    t: 'A galaxy of jams',
    d: "Every live session is a star in a browsable starfield — bigger with more people, fading as it goes quiet. Click one to drop straight in. The whole example library orbits as constellations.",
  },
  {
    t: 'Record the knob-twist',
    d: "Arm any number, nudge it live, and your gesture is captured and swapped into the code as the right TimeVar — a ramp becomes linvar, a wobble becomes sinvar. Perform the automation, keep the code.",
  },
  {
    t: 'Share a set in a link',
    d: "The whole composition rides inside a URL — no server, never expires. Paste it anywhere; it opens that exact buffer, ready to run.",
  },
  {
    t: 'Patterns &amp; automation',
    d: "PRand, PEuclid, PWalk, PLorenz and 30-odd friends, plus var / linvar / sinvar to sweep any parameter over beats. Set it moving, then pretend you planned it.",
  },
  {
    t: 'MIDI in &amp; out',
    d: "Map a hardware knob to anything, or fire phase-locked notes into your DAW. Yes, the browser does MIDI. No, we don't fully understand why either.",
  },
  {
    t: 'Tight enough to dance to',
    d: "A drift-compensated scheduler bundles OSC against the audio clock. Translation: it stays in time even when your laptop is thermal-throttling mid-set.",
  },
  {
    t: 'Panic button included',
    d: "Record straight to .webm, one-click the default sample kit, five themes to match your mood. And Ctrl+; kills everything the instant it all goes wrong.",
  },
];
---
<section id="features">
  <div class="wrap">
    <span class="eyebrow">./features --all</span>
    <h2 class="section-title">A whole studio in a browser tab you'll forget to close</h2>
    <p class="section-lead">
      Everything FoxDot gives you on the desktop, crammed into a single page —
      plus a few things it never had and SuperCollider users will be quietly
      jealous of.
    </p>

    <div class="feat-grid">
      {features.map((f) => (
        <article class="feat bracket">
          <h3 class="feat-t">{f.t}</h3>
          <p class="feat-d" set:html={f.d}></p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 38px;
  }
  .feat {
    background: var(--bg-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius);
    padding: 22px 20px;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }
  .feat:hover {
    border-color: var(--green);
    transform: translateY(-3px);
    background: var(--bg-3);
    box-shadow: 0 0 22px -10px var(--glow);
  }
  .feat-t {
    font-size: 16px;
    margin: 0 0 10px;
    color: var(--text-1);
    padding-left: 16px;
    position: relative;
  }
  .feat-t::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--green);
  }
  .feat-d { font-size: 13.5px; color: var(--text-2); margin: 0; }
  @media (max-width: 900px) { .feat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .feat-grid { grid-template-columns: 1fr; } }
</style>
