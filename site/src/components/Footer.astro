---
const repo = 'https://github.com/CrashServer/webfoxdot-dev';
const year = 2026;
---
<footer class="ftr">
  <div class="wrap ftr-inner">
    <div class="ftr-brand">
      <span class="brand-dot" aria-hidden="true"></span>
      <span>crashDot</span>
    </div>
    <p class="ftr-tag">
      Browser-native FoxDot live coding by
      <a href="https://github.com/CrashServer" target="_blank" rel="noopener">CrashServer</a>.
      Standing on the shoulders of
      <a href="https://supercollider.github.io" target="_blank" rel="noopener">SuperCollider</a>
      and <a href="https://foxdot.org" target="_blank" rel="noopener">FoxDot</a>,
      occasionally pulling their hair.
    </p>
    <nav class="ftr-links">
      <a href={repo} target="_blank" rel="noopener">GitHub</a>
      <a href={`${repo}#readme`} target="_blank" rel="noopener">Docs</a>
      <a href="#top">Back to top ↑</a>
    </nav>
  </div>
  <div class="wrap ftr-fine">
    <span class="ftr-flavor">// the revolution will be glitched</span>
    <span>© {year} CrashServer · α26</span>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--border-1);
    padding: 44px 0 32px;
    background: var(--bg-0);
  }
  .ftr-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .ftr-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-weight: 700;
    color: var(--text-1);
  }
  .brand-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--green); box-shadow: 0 0 10px var(--glow);
  }
  .ftr-tag { color: var(--text-2); font-size: 14px; margin: 0; flex: 1; min-width: 240px; }
  .ftr-links { display: flex; gap: 20px; font-size: 14px; }
  .ftr-links a { color: var(--text-2); }
  .ftr-links a:hover { color: var(--green); }
  .ftr-fine {
    margin-top: 22px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .ftr-flavor { color: var(--green); opacity: 0.7; }
</style>
