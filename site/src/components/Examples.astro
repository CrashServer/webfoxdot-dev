---
import Code from './Code.astro';

const examples = [
  {
    t: 'A bassline that breathes',
    d: "Sweep the filter with an exponential TimeVar. Instant \"I produce now\" energy.",
    code: `d1 >> dbass([0, 0, 3, 5], oct=3, dur=0.5,
            cutoff=expvar([200, 5000], [16, 16]),
            drive=0.4)`,
  },
  {
    t: 'Euclidean drums',
    d: "Maths that somehow grooves. Stutters itself every 8 bars so you can sip your drink.",
    code: `b1 >> play("X-o-", sample=1)
b2 >> play(PEuclid(8, 3), oct=6).every(8, "stutter", 4)`,
  },
  {
    t: 'Generative melody',
    d: "A drunk walk through D dorian. It'll find notes you wouldn't have.",
    code: `Scale.default = "dorian"
m1 >> saw(PWalk(max=7, step=2), oct=5,
          reverb=0.4, sus=linvar([0.2, 1], 32))`,
  },
  {
    t: 'Send notes to your DAW',
    d: "Phase-locked MIDI out, chords and all. Let Ableton take the credit.",
    code: `m1 >> midiout([0, (0, 4, 7), 5],
              channel=1, oct=4, dur=1, amp=0.9)`,
  },
];
---
<section id="examples">
  <div class="wrap">
    <span class="eyebrow">cat examples/*.fox</span>
    <h2 class="section-title">It reads like the music it makes</h2>
    <p class="section-lead">
      Each player is one line: a name, the <code class="inline">&gt;&gt;</code>
      operator, a synth, and some parameters. Patterns and TimeVars do the
      heavy lifting while you take the applause.
    </p>

    <div class="ex-grid">
      {examples.map((e) => (
        <article class="ex bracket">
          <div class="ex-head">
            <h3 class="ex-t">{e.t}</h3>
            <p class="ex-d">{e.d}</p>
          </div>
          <Code code={e.code} />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ex-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 38px;
  }
  .ex {
    background: var(--bg-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ex-head { display: flex; flex-direction: column; gap: 4px; }
  .ex-t { font-size: 16px; margin: 0; color: var(--text-1); }
  .ex-d { font-size: 13.5px; color: var(--text-2); margin: 0; }
  .ex :global(pre.code) { background: var(--bg-1); margin-top: auto; }
  @media (max-width: 800px) { .ex-grid { grid-template-columns: 1fr; } }
</style>
