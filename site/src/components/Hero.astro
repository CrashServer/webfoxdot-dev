---
import Code from './Code.astro';
import { REPO as repo, SOLO_URL, VERSION } from '../config';
const demo = `# warning: leaving this running is how gigs happen
Clock.bpm = 140
Scale.default = "dorian"

d1 >> dbass([0, -3, 0, 4], oct=3,
            cutoff=expvar([300, 4000], [16, 16]))

s1 >> saw(PEuclid(8, 5), oct=5,
          reverb=0.3, drive=sinvar([0, 1], 32))

b1 >> play("x-o-", sample=2).every(8, "stutter", 4)`;
---
<section id="top" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="badge">
        <span class="badge-dot"></span> SIGNAL ESTABLISHED · scsynth.wasm · no install · works offline
      </span>
      <h1 class="hero-title">
        Live-code music<br />in your <span class="glitch grad" data-text="browser">browser</span>.
      </h1>
      <p class="hero-lead">
        <strong>crashDot</strong> is a browser-native port of
        <a href="https://foxdot.org" target="_blank" rel="noopener">FoxDot</a>.
        Write Python-ish code, hit <kbd>Ctrl</kbd>+<kbd>Enter</kbd>, and hear it
        before your doubt catches up — SuperCollider's
        <code class="inline">scsynth</code> compiled to WebAssembly. No install,
        no <code class="inline">s.boot</code>, no praying.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={SOLO_URL} target="_blank" rel="noopener">Launch crashDot ▸</a>
        <a class="btn btn-ghost" href="#play">Jam with others</a>
      </div>
      <ul class="hero-stats">
        <li><b>46+</b> synths</li>
        <li><b>50+</b> ways to ruin them</li>
        <li><b>30+</b> pattern generators</li>
      </ul>
    </div>

    <div class="editor" aria-hidden="true">
      <div class="editor-bar">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
        <span class="editor-title">crashDot · {VERSION}</span>
      </div>
      <Code code={demo} />
      <div class="editor-foot">
        <span class="run">▸ Ctrl+Enter to commit · Ctrl+. to panic</span>
        <span class="bpm">♩ 140 bpm</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: 64px; padding-bottom: 72px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-2);
    background: var(--bg-2);
    border: 1px solid var(--border-1);
    border-radius: 999px;
    padding: 5px 13px;
    margin-bottom: 22px;
  }
  .badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--green); box-shadow: 0 0 8px var(--glow);
  }
  .hero-title {
    font-size: clamp(38px, 6vw, 62px);
    margin: 0 0 20px;
    letter-spacing: -0.03em;
  }
  .grad {
    display: inline-block;
    padding-right: 0.08em;
    margin-right: -0.08em;
    color: var(--green);
    text-shadow: 0 0 24px var(--glow), 0 0 4px rgba(0, 255, 65, 0.6);
  }
  .hero-lead {
    font-size: 18px;
    color: var(--text-2);
    max-width: 54ch;
    margin: 0 0 28px;
  }
  .hero-lead strong { color: var(--text-1); }
  kbd {
    font-family: var(--mono);
    font-size: 0.8em;
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 1px 6px;
    color: var(--text-1);
  }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 30px; }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-2);
  }
  .hero-stats b { color: var(--green); font-size: 16px; margin-right: 4px; }

  .editor {
    border: 1px solid var(--border-2);
    border-radius: 12px;
    background: var(--bg-1);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8), 0 0 60px -30px var(--glow);
    overflow: hidden;
  }
  .editor-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border-1);
  }
  .dot { width: 11px; height: 11px; border-radius: 50%; }
  .dot.r { background: #f85149; }
  .dot.y { background: #d29922; }
  .dot.g { background: #3fb950; }
  .editor-title {
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-2);
  }
  .editor :global(pre.code) { border: none; border-radius: 0; background: var(--bg-1); }
  .editor-foot {
    display: flex;
    justify-content: space-between;
    padding: 9px 16px;
    background: var(--bg-2);
    border-top: 1px solid var(--border-1);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-3);
  }
  .editor-foot .run { color: var(--green); }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
