---
import { APP_URL, SOLO_URL, JAM_URL, SESSIONS_FEED } from '../config';
---
<section id="play">
  <div class="wrap">
    <span class="eyebrow">./launch</span>
    <h2 class="section-title">No install. Open it and make noise.</h2>
    <p class="section-lead">
      crashDot runs entirely in your browser — nothing to download, nothing to set
      up. Pick a door.
    </p>

    <div class="play-grid">
      <article class="play-card bracket">
        <div class="pc-icon">▸</div>
        <h3>Play solo</h3>
        <p>Open it, click <b>boot</b>, write a line, hit <kbd>Ctrl</kbd>+<kbd>↵</kbd>. That's the whole setup.</p>
        <a class="btn btn-primary" href={SOLO_URL} target="_blank" rel="noopener">Launch crashDot ▸</a>
      </article>

      <article class="play-card bracket">
        <div class="pc-icon">👥</div>
        <h3>Jam together</h3>
        <p>Spin up a live room and share the link — everyone edits the same set in real time, in sync.</p>
        <a class="btn btn-primary" id="jam-link" href={JAM_URL} target="_blank" rel="noopener">Start a jam ▸</a>
      </article>

      <article class="play-card bracket">
        <div class="pc-icon">🌌</div>
        <h3>Join the galaxy</h3>
        <p>Every live jam is a star. Drop into one, or browse the whole example library as constellations.</p>
        <a class="btn btn-ghost" href={APP_URL} target="_blank" rel="noopener">Open the galaxy ▸</a>
      </article>
    </div>

    <div class="galaxy-live bracket">
      <div class="gl-head">
        <span class="gl-title"><span class="gl-dot"></span> live jams</span>
        <span class="gl-status" id="gl-status">connecting…</span>
      </div>
      <canvas id="gl-canvas"></canvas>
      <div class="gl-foot">a live starfield of every jam running right now · click a star to drop in</div>
    </div>
  </div>
</section>

<script define:vars={{ feed: SESSIONS_FEED, appUrl: APP_URL }}>
  // Mint a fresh multiplayer room per visitor.
  try {
    const j = document.getElementById('jam-link');
    if (j) j.href = appUrl + '/?session=jam-' + Math.random().toString(36).slice(2, 8);
  } catch (e) {}

  // Realtime galaxy widget — polls the collab server's public /sessions feed and
  // renders each live jam as a glowing star. Degrades to a calm starfield if the
  // feed isn't reachable (e.g. the app isn't deployed yet).
  (function () {
    const canvas = document.getElementById('gl-canvas');
    const statusEl = document.getElementById('gl-status');
    if (!canvas || !canvas.getContext) return;
    const ctx = canvas.getContext('2d');
    let W = 0, H = 0, DPR = 1, stars = [];
    const nodes = new Map();
    const hash = (s) => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; };
    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth; H = canvas.clientHeight || 240;
      canvas.width = W * DPR; canvas.height = H * DPR; ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      stars = Array.from({ length: Math.round(W * H / 6500) }, (_, i) => ({
        x: hash('b' + i) % 1000 / 1000 * W, y: hash('c' + i) % 1000 / 1000 * H,
        r: 0.4 + hash('r' + i) % 100 / 100 * 0.8, t: hash('t' + i) % 628 / 100 }));
    }
    function place(n) { const h = hash(n.slug); n.x = 48 + (h % 997) / 997 * (W - 96); n.y = 34 + ((h >>> 11) % 991) / 991 * (H - 68); }
    async function poll() {
      try {
        const d = await (await fetch(feed, { cache: 'no-store' })).json();
        const list = d.sessions || [], seen = new Set();
        for (const s of list) { seen.add(s.slug); let n = nodes.get(s.slug); if (!n) { n = { slug: s.slug, a: 0 }; place(n); nodes.set(s.slug, n); } n.clients = s.clients; n.dormant = !!s.dormant; n.gone = false; }
        for (const [k, n] of nodes) if (!seen.has(k)) n.gone = true;
        const live = list.filter(s => !s.dormant).length;
        statusEl.textContent = live ? (live + ' jam' + (live > 1 ? 's' : '') + ' live now') : 'no jams right now — start one';
      } catch (e) { statusEl.textContent = 'signal offline'; }
    }
    function draw(t) {
      ctx.clearRect(0, 0, W, H);
      for (const s of stars) { ctx.globalAlpha = 0.18 + Math.sin(t * 0.001 + s.t) * 0.12; ctx.fillStyle = '#2f5f3f'; ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, 7); ctx.fill(); }
      ctx.globalAlpha = 1;
      for (const [k, n] of nodes) {
        n.a += ((n.gone ? 0 : 1) - n.a) * 0.08; if (n.gone && n.a < 0.02) { nodes.delete(k); continue; }
        const r = 6 + Math.min(n.clients || 1, 8) * 2.2, c = n.dormant ? [80, 140, 110] : [0, 255, 80];
        const tw = n.dormant ? 1 : 0.85 + Math.sin(t * 0.004 + (n.x + n.y)) * 0.15, a = n.a * tw;
        const g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, r * 3);
        g.addColorStop(0, `rgba(${c[0]},${c[1]},${c[2]},${0.5 * a})`); g.addColorStop(1, `rgba(${c[0]},${c[1]},${c[2]},0)`);
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(n.x, n.y, r * 3, 0, 7); ctx.fill();
        ctx.globalAlpha = a; ctx.fillStyle = n.dormant ? '#8fbf9f' : '#aaffbf'; ctx.beginPath(); ctx.arc(n.x, n.y, r * 0.5, 0, 7); ctx.fill();
        ctx.globalAlpha = Math.min(1, a + 0.2); ctx.fillStyle = 'rgba(200,245,212,0.9)'; ctx.font = '11px ui-monospace, monospace'; ctx.textAlign = 'center';
        ctx.fillText(n.slug, n.x, n.y + r + 15);
        ctx.globalAlpha = 1; n.hitR = r * 3;
      }
      requestAnimationFrame(draw);
    }
    canvas.addEventListener('click', (e) => {
      const rc = canvas.getBoundingClientRect(), mx = e.clientX - rc.left, my = e.clientY - rc.top;
      for (const [k, n] of nodes) if (Math.hypot(mx - n.x, my - n.y) < (n.hitR || 20)) { window.open(appUrl + '/?session=' + encodeURIComponent(n.slug), '_blank'); return; }
    });
    resize(); window.addEventListener('resize', resize);
    poll(); setInterval(poll, 4000); requestAnimationFrame(draw);
  })();
</script>

<style>
  #play { padding-top: 8px; }
  .play-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 30px 0 26px; }
  .play-card { padding: 22px 20px; display: flex; flex-direction: column; gap: 10px; }
  .pc-icon { font-size: 22px; color: var(--green); text-shadow: 0 0 14px var(--glow); }
  .play-card h3 { margin: 0; font-size: 18px; color: var(--text-1); }
  .play-card p { margin: 0; color: var(--text-2); font-size: 14.5px; line-height: 1.5; flex: 1; }
  .play-card .btn { margin-top: 6px; align-self: flex-start; }
  .play-card kbd {
    font-family: var(--mono); font-size: 0.78em; background: var(--bg-3);
    border: 1px solid var(--border-2); border-radius: 4px; padding: 0 5px; color: var(--text-1);
  }

  .galaxy-live { padding: 0; overflow: hidden; }
  .gl-head { display: flex; align-items: center; justify-content: space-between; padding: 11px 16px; border-bottom: 1px solid var(--border-1); background: var(--bg-2); }
  .gl-title { font-family: var(--mono); font-size: 13px; color: var(--text-1); display: flex; align-items: center; gap: 8px; }
  .gl-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px var(--glow); animation: glpulse 2.2s ease-in-out infinite; }
  @keyframes glpulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  .gl-status { font-family: var(--mono); font-size: 12px; color: var(--text-2); }
  #gl-canvas { display: block; width: 100%; height: 240px; background: radial-gradient(120% 100% at 50% 0%, #071008 0%, #030503 100%); cursor: pointer; }
  .gl-foot { padding: 9px 16px; font-family: var(--mono); font-size: 11.5px; color: var(--text-3); border-top: 1px solid var(--border-1); background: var(--bg-2); }

  @media (max-width: 820px) { .play-grid { grid-template-columns: 1fr; } }
</style>
