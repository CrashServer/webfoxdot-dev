---
const synths = [
  'dbass', 'saw', 'sine', 'rsin', 'donk', 'ebass', 'faim', 'guit',
  'lapin', 'acidbass', 'hoover', 'cs80', 'moogpluck', 'pads', 'blip', 'arpy',
];
const fx = [
  'reverb', 'room', 'lpf', 'hpf', 'drive', 'tanh', 'echo', 'fold',
  'vowel', 'lofi', 'crush', 'octclean', 'csweep', 'tube', 'feed', 'sbrk',
];
---
<section id="library">
  <div class="wrap">
    <span class="eyebrow">ls synthdefs/</span>
    <h2 class="section-title">Synths &amp; effects, no rabbit holes</h2>
    <p class="section-lead">
      Ported from FoxDot and CrashServer's SuperCollider library, plus Mutable
      Instruments mi-UGens smuggled into the WASM build. Pick one and go — the
      synthesis rabbit hole is optional.
    </p>

    <div class="lib-cols">
      <div class="lib-col">
        <h3 class="lib-h"><span class="lib-tag synth">synths</span> 29 (someone always ports one more)</h3>
        <div class="chips">
          {synths.map((s) => <span class="chip synth">{s}</span>)}
          <span class="chip more">+13 more</span>
        </div>
      </div>
      <div class="lib-col">
        <h3 class="lib-h"><span class="lib-tag fx">effects</span> 40+ chain stages</h3>
        <div class="chips">
          {fx.map((f) => <span class="chip fx">{f}</span>)}
          <span class="chip more">+more</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lib-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 38px;
  }
  .lib-h {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lib-tag {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 5px;
  }
  .lib-tag.synth { background: var(--green-dim); color: var(--tok-synth); }
  .lib-tag.fx { background: rgba(210, 168, 255, 0.14); color: var(--tok-pattern); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font-family: var(--mono);
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 7px;
    background: var(--bg-2);
    border: 1px solid var(--border-1);
    transition: border-color 0.12s ease, transform 0.12s ease;
  }
  .chip:hover { transform: translateY(-2px); }
  .chip.synth { color: var(--tok-synth); }
  .chip.synth:hover { border-color: var(--green); }
  .chip.fx { color: var(--tok-pattern); }
  .chip.fx:hover { border-color: var(--purple); }
  .chip.more { color: var(--text-3); }
  @media (max-width: 720px) { .lib-cols { grid-template-columns: 1fr; gap: 32px; } }
</style>
