---
const groups = [
  {
    label: 'audio engine',
    items: [
      {
        n: 'SuperCollider',
        d: "Its scsynth server is the synthesis engine doing all the actual sound. The hard part. We just boot it.",
        u: 'https://supercollider.github.io',
      },
      {
        n: 'SuperSonic',
        d: "Sam Aaron's project that compiles scsynth to WebAssembly and ferries OSC across the SharedArrayBuffer. Without it, none of this exists.",
        u: 'https://github.com/samaaron/supersonic',
      },
      {
        n: 'mi-UGens',
        d: "Mutable Instruments' Plaits, Clouds & Rings (Émilie Gillet), ported to SuperCollider by Volker Böhm and baked into the build.",
        u: 'https://github.com/v7b1/mi-UGens',
      },
      {
        n: 'Emscripten',
        d: 'The toolchain that dragged scsynth from C++ all the way down to a .wasm binary.',
        u: 'https://emscripten.org',
      },
      {
        n: 'WebAssembly',
        d: 'Runs that native audio code at near-native speed, in a tab, which still feels illegal.',
        u: 'https://webassembly.org',
      },
      {
        n: 'Web Audio API',
        d: 'The AudioWorklet that streams finished samples out to your speakers.',
        u: 'https://developer.mozilla.org/en-US/docs/Web/API/Web_Audio_API',
      },
    ],
  },
  {
    label: 'language & sounds',
    items: [
      {
        n: 'FoxDot',
        d: "Ryan Kirkbride's live-coding language. crashDot is a port of its idiom — the player >> synth() everyone fell for.",
        u: 'https://foxdot.org',
      },
      {
        n: 'Sonic Pi',
        d: "A handful of SynthDefs borrowed from Sam Aaron's other gift to live coding.",
        u: 'https://sonic-pi.net',
      },
      {
        n: 'Open Sound Control',
        d: 'The message protocol the player engine speaks to scsynth, beat after beat.',
        u: 'https://opensoundcontrol.stanford.edu',
      },
    ],
  },
  {
    label: 'editor & collab',
    items: [
      {
        n: 'CodeMirror 5',
        d: 'The in-browser editor — syntax overlay, autocomplete, and the keybindings you live in.',
        u: 'https://codemirror.net/5/',
      },
      {
        n: 'Yjs',
        d: 'The CRDT behind shared sessions, so two people can fight over the same line in real time.',
        u: 'https://yjs.dev',
      },
    ],
  },
  {
    label: 'tooling & this site',
    items: [
      {
        n: 'Python',
        d: 'Runs the dev server that sets the COOP/COEP headers SharedArrayBuffer demands.',
        u: 'https://www.python.org',
      },
      {
        n: 'Astro',
        d: 'This very page. No client JS, just static HTML pretending to be a terminal.',
        u: 'https://astro.build',
      },
    ],
  },
  {
    label: 'the culprits',
    items: [
      {
        n: 'CrashServer',
        d: "The collective that ported, glued and live-codes all of this — plus the SynthDefs, FX and the webfoxdot-kit sample pack. The revolution will be glitched.",
        u: 'https://github.com/CrashServer',
      },
      {
        n: 'webTroop',
        d: "CrashServer's earlier browser FoxDot IDE. crashDot inherits its collaborative model, the #@ section sequencer and the shorthand operators.",
        u: 'https://github.com/CrashServer',
      },
      {
        n: 'The synths & the rest',
        d: "Years of CrashServer SynthDefs, effects and patches, FoxDot ports and assorted hacks that crashDot quietly stands on. You know who you are.",
        u: 'https://github.com/CrashServer',
      },
    ],
  },
];
---
<section id="credits">
  <div class="wrap">
    <span class="eyebrow">cat CREDITS.txt</span>
    <h2 class="section-title">Standing on a lot of shoulders</h2>
    <p class="section-lead">
      crashDot is glue. The genius is in the open-source projects below — every
      one of them is worth your time, a star, and probably a donation.
    </p>

    {groups.map((g) => (
      <div class="cr-group">
        <h3 class="cr-label"><span class="cr-bullet">▚</span> {g.label}</h3>
        <div class="cr-grid">
          {g.items.map((it) => (
            <a class="cr-card bracket" href={it.u} target="_blank" rel="noopener">
              <span class="cr-head">
                <span class="cr-name">{it.n}</span>
                <span class="cr-arrow" aria-hidden="true">↗</span>
              </span>
              <span class="cr-desc">{it.d}</span>
              <span class="cr-url">{it.u.replace(/^https?:\/\//, '')}</span>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="thanks bracket">
      <h3 class="thanks-label"><span class="cr-bullet">♥</span> special thanks</h3>
      <p class="thanks-body">
        To <strong>Vlad Kitty Clock</strong> — for keeping the FoxDot community
        alive and welcoming year after year. The patches, the answers, the
        late-night encouragement: half the people writing
        <code class="inline">p1 &gt;&gt;</code> today are here because of you.
      </p>
      <p class="thanks-body">
        And to the people who built the ground this stands on:
        <strong>Ryan Kirkbride</strong> (FoxDot), <strong>Sam Aaron</strong>
        (Sonic Pi &amp; SuperSonic), <strong>Patrick Borgeat</strong> and
        <strong>Dan Stowell</strong> — for years of SuperCollider, live coding
        and sheer generosity.
      </p>
      <p class="thanks-foot">
        — and to every live coder who ever stayed for the encore.
      </p>
    </div>
  </div>
</section>

<style>
  .thanks {
    margin-top: 48px;
    padding: 30px 32px;
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(255, 0, 255, 0.07), transparent 60%),
      var(--bg-2);
    border: 1px solid var(--border-2);
    border-radius: var(--radius);
  }
  .thanks-label {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .thanks-label .cr-bullet { color: var(--magenta); }
  .thanks-body {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-1);
    margin: 0 0 12px;
    max-width: 72ch;
  }
  .thanks-body strong { color: var(--green-bright); text-shadow: 0 0 12px var(--glow); }
  .thanks-foot {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-2);
    margin: 0;
    opacity: 0.85;
  }

  .cr-group { margin-top: 40px; }
  .cr-label {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .cr-bullet { color: var(--magenta); }
  .cr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .cr-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    background: var(--bg-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius);
    color: var(--text-1);
    transition: border-color 0.14s ease, transform 0.14s ease, box-shadow 0.18s ease;
  }
  .cr-card:hover {
    border-color: var(--green);
    transform: translateY(-3px);
    box-shadow: 0 0 22px -10px var(--glow);
    color: var(--text-1);
  }
  .cr-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .cr-name {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 15px;
    color: var(--green-bright);
  }
  .cr-arrow { color: var(--text-3); font-size: 13px; transition: color 0.14s ease; }
  .cr-card:hover .cr-arrow { color: var(--green); }
  .cr-desc { font-size: 13px; color: var(--text-2); line-height: 1.55; }
  .cr-url {
    margin-top: auto;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-3);
    word-break: break-all;
  }
  @media (max-width: 820px) { .cr-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .cr-grid { grid-template-columns: 1fr; } }
</style>
